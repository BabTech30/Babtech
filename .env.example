# Variables facultatives, lues au moment du build. En local : copier ce fichier en .env.local.
# En ligne : hPanel → application Node.js → Variables d'environnement (même nom, avec NEXT_PUBLIC_),
# puis redéployer. Le domaine du site se règle dans src/lib/site.ts (DEFAULT_SITE_URL).

# Uniquement pour une version de test sur une autre adresse que le domaine principal.
NEXT_PUBLIC_SITE_URL=

# Téléphone au format international (ex. +33612345678). Vide : le numéro de src/lib/site.ts est utilisé.
NEXT_PUBLIC_PHONE=

# Formulaires Formspree (identifiant après https://formspree.io/f/).
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=xykbpjbz
# Formulaire dédié à la communauté (sinon, le formulaire de contact est utilisé).
NEXT_PUBLIC_FORMSPREE_COMMUNITY_ID=

# Espace client (laisser vide pour masquer le bouton).
NEXT_PUBLIC_CLIENT_SPACE_URL=

# Mesure d'audience sans cookie (choisir l'une des deux, ou aucune).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vérification des outils pour webmasters (balises meta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Assistant IA de la page Contact (Claude, d'Anthropic), lu au démarrage du site. À saisir dans hPanel
# uniquement, jamais dans ce fichier ni sur GitHub : clé créée sur https://platform.claude.com/settings/keys.
# Vide : la page Contact affiche le formulaire classique.
ANTHROPIC_API_KEY=

# Espace /admin (tableau de bord privé). À saisir dans hPanel uniquement :
# jamais dans ce fichier ni sur GitHub (le dépôt est public).
ADMIN_USERNAME=
# Mot de passe de départ, à remplacer ensuite dans /admin/reglages/.
ADMIN_PASSWORD=
# Facultatif : dossier où /admin enregistre ses données (par défaut ~/.babtech-admin, hors du dossier du site).
ADMIN_DATA_DIR=
