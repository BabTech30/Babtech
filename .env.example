# Variables facultatives. En local : copier ce fichier en .env.local ou .env.production.
# Sur GitHub (build automatique) : Settings → Secrets and variables → Actions → Variables
# (PHONE, FORMSPREE_COMMUNITY_ID, PLAUSIBLE_DOMAIN… sans le préfixe NEXT_PUBLIC_).
# Le domaine du site se règle dans src/lib/site.ts (DEFAULT_SITE_URL).

# Uniquement pour une version de test sur l'adresse temporaire fournie par Hostinger.
NEXT_PUBLIC_SITE_URL=

# Téléphone au format international (ex. +33612345678). Fortement conseillé pour le SEO local.
NEXT_PUBLIC_PHONE=

# Formulaires Formspree (identifiant après https://formspree.io/f/).
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=xykbpjbz
# Formulaire dédié à la communauté (sinon, le formulaire de contact est utilisé).
NEXT_PUBLIC_FORMSPREE_COMMUNITY_ID=

# Prise de rendez-vous.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/babferrer

# Espace client (laisser vide pour masquer le bouton).
NEXT_PUBLIC_CLIENT_SPACE_URL=

# Mesure d'audience sans cookie (choisir l'une des deux, ou aucune).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vérification des outils pour webmasters (balises meta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
