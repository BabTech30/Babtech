# Variables du site. Pour une mise en ligne sur Hostinger, mets-les dans .env.production
# (build local avec `npm run build:hostinger`) ou dans les variables du dépôt GitHub
# (déploiement automatique, voir docs/DEPLOIEMENT.md). Pour le développement : .env.local.
# Toutes sont facultatives, sauf NEXT_PUBLIC_SITE_URL pour la mise en ligne.

# URL publique du site, sans slash final (ex. https://babtech.fr) : canonicals, sitemap,
# Open Graph, RSS, llms.txt et .htaccess en dépendent.
NEXT_PUBLIC_SITE_URL=https://babtech.fr

# Téléphone au format international (ex. +33612345678). Fortement conseillé pour le SEO local.
NEXT_PUBLIC_PHONE=

# Formulaires Formspree (identifiant après https://formspree.io/f/).
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=xykbpjbz
# Formulaire dédié à la communauté (sinon, le formulaire de contact est utilisé).
NEXT_PUBLIC_FORMSPREE_COMMUNITY_ID=

# Prise de rendez-vous.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/babferrer

# Espace client (laisser vide pour masquer le bouton).
NEXT_PUBLIC_CLIENT_SPACE_URL=

# Mesure d'audience sans cookie (choisir l'une des deux, ou aucune).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vérification des outils pour webmasters (balises meta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Ancien site Netlify uniquement : après la migration vers Hostinger, rediriger (301) toutes
# les pages vers le nouveau domaine. À définir dans Netlify, pas sur Hostinger.
REDIRECT_SITE_TO=
